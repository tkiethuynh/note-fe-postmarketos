# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-gracerlte
pkgdesc="Samsung Galaxy Note FE (SM-N935L)"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !spdx !tracedeps"
depends="
	postmarketos-base
	postmarketos-base-downstream
	postmarketos-base-downstream-disable-udev-v4l
	linux-samsung-gracerlte
	mkbootimg
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	initfs-hook.sh
	gracerlte-headless.start
	90-gracerlte-unmanaged.conf
	wifi-powersave.conf
	99-wifi-no-powersave
	gracerlte-firmware.tar.gz
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Install vendor firmware and Wi-Fi blobs extracted from Note FE
	mkdir -p "$pkgdir/vendor"
	cp -a "$srcdir/vendor/." "$pkgdir/vendor/"

	# Fallback symlinks for bcmdhd base paths & standard Linux firmware paths
	ln -sf bcmdhd_sta.bin_c0_plus_blob "$pkgdir/vendor/etc/wifi/bcmdhd_sta.bin"
	ln -sf nvram_net.txt_c0_plus "$pkgdir/vendor/etc/wifi/nvram_net.txt"
	mkdir -p "$pkgdir/etc" "$pkgdir/lib/firmware"
	ln -sf /vendor/etc/wifi "$pkgdir/etc/wifi"
	ln -sf /vendor/firmware "$pkgdir/lib/firmware/postmarketos"

	# Headless OpenRC local.d script & NetworkManager unmanaged USB gadget rule
	install -Dm755 "$srcdir/gracerlte-headless.start" \
		"$pkgdir/etc/local.d/gracerlte-headless.start"
	install -Dm644 "$srcdir/90-gracerlte-unmanaged.conf" \
		"$pkgdir/etc/NetworkManager/conf.d/90-gracerlte-unmanaged.conf"
	install -Dm644 "$srcdir/wifi-powersave.conf" \
		"$pkgdir/etc/NetworkManager/conf.d/wifi-powersave.conf"
	install -Dm755 "$srcdir/99-wifi-no-powersave" \
		"$pkgdir/etc/NetworkManager/dispatcher.d/99-wifi-no-powersave"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -sf /etc/init.d/local "$pkgdir/etc/runlevels/default/local"
}
