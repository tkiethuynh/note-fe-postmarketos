# Reference: <https://postmarketos.org/vendorkernel>
maintainer=""
pkgname=linux-samsung-gracerlte
pkgver=3.18.140
pkgrel=0
pkgdesc="Samsung Galaxy Note FE (SM-N935L) downstream kernel from UBports 24"
arch="aarch64"
_flavor="samsung-gracerlte"
url="https://gitlab.com/ubports/porting/community-ports/android11/samsung-galaxy-s7/kernel-samsung-universal8890"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="devicepkg-dev"
_config="config-$_flavor.$arch"
source="
	Image
	dt.img
	$_config
"

prepare() {
	default_prepare
}

build() {
	:
}

package() {
	local _kver="3.18.140-ge697e3acd8b2"
	install -Dm644 "$srcdir/Image" "$pkgdir/boot/vmlinuz"
	install -Dm644 "$srcdir/dt.img" "$pkgdir/boot/dt.img"
	mkdir -p "$pkgdir/usr/share/kernel/$_flavor"
	echo "$_kver" > "$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	mkdir -p "$pkgdir/lib/modules/$_kver"
	touch "$pkgdir/lib/modules/$_kver/modules.dep"
	touch "$pkgdir/lib/modules/$_kver/modules.order"
	touch "$pkgdir/lib/modules/$_kver/modules.builtin"
}
